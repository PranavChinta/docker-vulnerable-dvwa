+<?php
+
+/**
+ * PHPIDS
+ *
+ * Requirements: PHP5, SimpleXML
+ *
+ * Copyright (c) 2008 PHPIDS group (http://php-ids.org)
+ *
+ * PHPIDS is free software; you can redistribute it and/or modify
