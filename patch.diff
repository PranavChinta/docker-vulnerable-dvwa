+++ b/dvwa_webapp/dvwa/external/phpids/0.6/lib/IDS/Init.php
@@ -0,0 +1,232 @@
+<?php
+
+/**
+ * PHPIDS
+ * 
+ * Requirements: PHP5, SimpleXML
+ *
