+		<input type="submit" id="send" name="send" value="Submit" />
+	</form>
+EOF;
+}
+
+require_once DVWA_WEB_PAGE_TO_ROOT . "vulnerabilities/javascript/source/{$vulnerabilityFile}";
+
+$page[ 'body' ] .= <<<EOF
