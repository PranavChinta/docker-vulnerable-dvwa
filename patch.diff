+ * End:
+ * vim600: sw=4 ts=4 expandtab
+ */
diff --git a/dvwa_webapp/dvwa/external/phpids/0.6/lib/IDS/Init.php b/dvwa_webapp/dvwa/external/phpids/0.6/lib/IDS/Init.php
new file mode 100644
